# ── Domain & HTTPS ────────────────────────────────────────────────────────────
DOMAIN=cerebromat.example.com
ACME_EMAIL=admin@example.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cerebromat
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=cerebromat

# ── JWT Secrets (min 12 chars each) ──────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_12_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_12_chars

# ── GitHub Container Registry ────────────────────────────────────────────────
# Format: owner/repo — MUST be lowercase (e.g., myorg/cerebromat)
GITHUB_REPOSITORY=owner/cerebromat
