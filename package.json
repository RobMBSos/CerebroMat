{
  "name": "cerebromat",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo local para app web + móvil de matemáticas escolares",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n shared,api,web,mobile -c yellow,green,blue,magenta \"pnpm --filter @cerebromat/shared dev\" \"pnpm --filter @cerebromat/api dev\" \"pnpm --filter @cerebromat/web dev\" \"pnpm --filter @cerebromat/mobile dev\"",
    "dev:docker": "docker compose up -d",
    "build": "pnpm -r --if-present build",
    "test": "node --test tools/*.test.cjs && pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "db:migrate": "pnpm --filter @cerebromat/api db:migrate",
    "db:seed": "pnpm --filter @cerebromat/api db:seed",
    "db:studio": "pnpm --filter @cerebromat/api db:studio"
  },
  "pnpm": {
    "overrides": {
      "defu": "6.1.7",
      "proxy-addr": "2.0.8",
      "compression": "^1.8.2",
      "multer": "^2.3.0",
      "tar": "^7.5.21",
      "postcss": "8.5.29",
      "deepmerge-ts": "8.0.0",
      "@xmldom/xmldom": "0.8.15",
      "uuid": "11.1.1",
      "esbuild": "0.28.1",
      "js-yaml@>=5 <5.4.1": "5.4.1"
    },
    "packageExtensions": {
      "expo-router@4": {
        "dependencies": {
          "query-string": "^7.1.3"
        }
      }
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch",
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
